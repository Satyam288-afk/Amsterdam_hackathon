# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-key
# Set to true only after both frontend Supabase variables and this service-role
# key are configured. It makes every recovery API call require a verified JWT.
AUTH_REQUIRED=false
SUPABASE_BUCKET_NAME=your_bucket_name

# Supabase Postgresql url
DATABASE_URL=postgresql_url

# LLM APIs & STT & TTS
GOOGLE_API_KEY=your_gemini_key
# Opt in only after a data-processing review. Without this, the diagnosis API
# uses its deterministic, visible fallback classifier.
ENABLE_EXTERNAL_LLM_DIAGNOSIS=false
GEMINI_MODEL_NAME=gemini-2.5-flash
HF_API_KEY=hf_your_hugging_face_token_here
SARVAM_API_KEY=your_sarvam_key_here

# Telephony
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_FROM=whatsapp:+1234567890
TWILIO_WEBHOOK_BASE_URL=this_deployed_url


# Redis for queue [optional]
REDIS_URL=redis://localhost:6379

# ngrok auth token
NGROK_AUTH_TOKEN=your_auth_token_here

# Env
MODE=development
ENVIRONMENT=development
